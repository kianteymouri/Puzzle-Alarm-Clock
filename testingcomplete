TIME_RE = re.compile(r"^\d{2}:\d{2}$")

def _valid_time(t: str) -> bool:
    if not TIME_RE.match(t):
        return False
    h, m = t.split(":")
    return 0 <= int(h) <= 23 and 0 <= int(m) <= 59

def load_alarms() -> list[dict]:
    """
    Returns a list of alarm dicts like:
        {"time": "07:30", "mode": "easy"}
    Supports legacy string alarms too.
    """
    if not os.path.exists(ALARMS_FILE):
        return []

    try:
        with open(ALARMS_FILE, "r") as f:
            fcntl.flock(f, fcntl.LOCK_SH)
            data = json.load(f)
            fcntl.flock(f, fcntl.LOCK_UN)

        if not isinstance(data, list):
            return []

        normalized = []
        for item in data:
            if isinstance(item, str):
                normalized.append({"time": item, "mode": "easy"})
            elif isinstance(item, dict) and "time" in item:
                mode = item.get("mode", "easy")
                if mode not in VALID_MODES:
                    mode = "easy"
                normalized.append({
                    "time": item["time"],
                    "mode": mode,
                })
        return normalized

    except Exception as e:
        print(f"[alarm] load error: {e}")
        return []

def save_alarms(alarms: list[dict]):
    seen = {}
    for alarm in alarms:
        t = alarm.get("time", "")
        if not t:
            continue
        mode = alarm.get("mode", "easy")
        if mode not in VALID_MODES:
            mode = "easy"
        seen[t] = {"time": t, "mode": mode}

    ordered = sorted(seen.values(), key=lambda x: x["time"])

    tmp = ALARMS_FILE + ".tmp"
    with open(tmp, "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        json.dump(ordered, f, indent=2)
        fcntl.flock(f, fcntl.LOCK_UN)
    os.replace(tmp, ALARMS_FILE)

def load_weather_temp() -> str:
    if not os.path.exists(WEATHER_FILE):
        return DEFAULT_TEMP_F

    try:
        with open(WEATHER_FILE, "r") as f:
            data = json.load(f)
        raw = data.get("temp_f", DEFAULT_TEMP_F)
        return normalize_temp_value(raw)
    except Exception as e:
        print(f"[weather] load error: {e}")
        return DEFAULT_TEMP_F

def save_weather_temp(temp_value: str):
    tmp = WEATHER_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"temp_f": temp_value}, f, indent=2)
    os.replace(tmp, WEATHER_FILE)

def normalize_temp_value(value) -> str:
    if value is None:
        return DEFAULT_TEMP_F

    try:
        if isinstance(value, str):
            value = value.strip()
            if value == "":
                return DEFAULT_TEMP_F
            value = float(value)
        return str(int(round(float(value))))
    except Exception:
        return DEFAULT_TEMP_F

def set_outside_temp(value):
    global outside_temp_f
    normalized = normalize_temp_value(value)
    with weather_lock:
        outside_temp_f = normalized
    save_weather_temp(normalized)

