_stop_music = threading.Event()

def start_audio(_unused=None):
    _stop_music.clear()
    threading.Thread(target=_buzzer_loop, daemon=True).start()

def _buzzer_loop():
    while not _stop_music.is_set():
        for note in TUNE:
            if _stop_music.is_set():
                break
            play_note(note, NOTE_DURATION)

def stop_audio():
    _stop_music.set()
    try:
        buzzer_pwm.stop()
    except Exception:
        pass

