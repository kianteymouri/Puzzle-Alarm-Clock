def run_proximity_challenge(target_min=5, target_max=15, hold_seconds=3):
    lcd_show_temp("Proximity Task", "Hold hand close", 1.5)
    start_hold = None
    
    while True:
        if alarm_state.should_cancel():
            return False
            
        dist = get_distance()
        
        # If hand is within the range (5cm to 15cm)
        if target_min <= dist <= target_max:
            if start_hold is None:
                start_hold = time.time()
            
            elapsed = time.time() - start_hold
            remaining = max(0, hold_seconds - elapsed)
            
            lcd_show("Hold Steady!", f"{round(remaining, 1)}s left", force=True)
            GPIO.output(GREEN_LED, GPIO.HIGH) 
            
            if elapsed >= hold_seconds:
                GPIO.output(GREEN_LED, GPIO.LOW)
                lcd_show_temp("Great Work!", "Sensor Passed", 1.6)
                return True
        else:
            # If hand moved away, reset the timer
            start_hold = None
            GPIO.output(GREEN_LED, GPIO.LOW)
            lcd_show("Target: 5-15cm", f"Current: {int(dist)}cm", force=True)
            
        time.sleep(0.1)


