def _generate_math_problem(hard=False):
    while True:
        op = random.choice(["+", "-", "*"])

        if hard:
            if op == "+":
                a = random.randint(20, 99)
                b = random.randint(10, 99)
            elif op == "-":
                a = random.randint(20, 99)
                b = random.randint(0, a)
            else:
                a = random.randint(4, 9)
                b = random.randint(4, 9)
        else:
            if op == "+":
                a, b = random.randint(0, 50), random.randint(0, 49)
            elif op == "-":
                a = random.randint(0, 99)
                b = random.randint(0, a)
            else:
                a, b = random.randint(0, 9), random.randint(0, 9)

        ans = eval(f"{a}{op}{b}")
        if 0 <= ans <= 99:
            return a, op, b, ans

def _choose_digit(label: str, top_line: str) -> int:
    digit = 0
    while True:
        if alarm_state.should_cancel():
            return -1

        lcd_show(top_line, f"{label}: {digit}", force=True)
        pressed = wait_for_button_press()

        if pressed == "red":
            digit = (digit + 1) % 10
            GPIO.output(RED_LED, GPIO.HIGH)
            time.sleep(0.12)
            GPIO.output(RED_LED, GPIO.LOW)

        elif pressed == "yellow":
            digit = (digit - 1) % 10
            GPIO.output(YELLOW_LED, GPIO.HIGH)
            time.sleep(0.12)
            GPIO.output(YELLOW_LED, GPIO.LOW)

        elif pressed == "green":
            GPIO.output(GREEN_LED, GPIO.HIGH)
            time.sleep(0.2)
            GPIO.output(GREEN_LED, GPIO.LOW)
            return digit

def run_math(hard=False):
    a, op, b, answer = _generate_math_problem(hard)

    while True:
        if alarm_state.should_cancel():
            return False

        question = f"{a}{op}{b}=?"
        lcd_show_temp("Solve this:", question, 1.4)

        tens = _choose_digit("Tens", question)
        if tens < 0:
            return False

        ones = _choose_digit("Ones", question)
        if ones < 0:
            return False

        user_answer = tens * 10 + ones
        lcd_show_temp("Your answer:", str(user_answer), 1.0)

        if user_answer == answer:
            lcd_show_temp("Math correct!", "Nice job", 1.6)
            return True

        lcd_show_temp("Incorrect", "Try again", 1.8)
        flash_all_leds(times=2)
        time.sleep(0.6)

# ============================================================
