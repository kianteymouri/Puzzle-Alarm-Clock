def fit_lcd(text: str) -> str:
    return str(text)[:LCD_WIDTH].ljust(LCD_WIDTH)

def center_lcd(text: str) -> str:
    return str(text)[:LCD_WIDTH].center(LCD_WIDTH)

def lcd_show(line1: str = "", line2: str = "", force: bool = False):
    global _last_line1, _last_line2

    line1 = fit_lcd(line1)
    line2 = fit_lcd(line2)

    with lcd_lock:
        if force or line1 != _last_line1:
            lcd.cursor_pos = (0, 0)
            lcd.write_string(line1)
            _last_line1 = line1

        if force or line2 != _last_line2:
            lcd.cursor_pos = (1, 0)
            lcd.write_string(line2)
            _last_line2 = line2

def lcd_clear_cache():
    global _last_line1, _last_line2
    with lcd_lock:
        lcd.clear()
        _last_line1 = None
        _last_line2 = None

def lcd_show_temp(line1: str = "", line2: str = "", duration: float = 1.5):
    _msg_override.set()
    lcd_clear_cache()
    lcd_show(line1, line2, force=True)
    time.sleep(duration)
    _msg_override.clear()

def build_clock_lines() -> tuple[str, str]:
    now_time = strftime("%I:%M %p").lstrip("0")
    now_date = strftime("%m/%d/%Y")

    with weather_lock:
        temp = outside_temp_f

    line1 = center_lcd(now_time)
    line2 = fit_lcd(f"{temp}F {now_date}")
    return line1, line2

