def run_mode(mode: str):
    steps = MODES.get(mode, ["math"])

    for step in steps:
        if alarm_state.should_cancel():
            return False

        if step == "math":
            if not run_math(False):
                return False

        elif step == "math_hard":
            if not run_math(True):
                return False

        elif step == "led":
            length = 7 if mode == "puzzle" else 5
            if not run_led(length):
                return False

    return True

